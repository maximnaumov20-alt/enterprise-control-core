# Store this file outside the repository and restrict it to root/ecc-backup.
ECC_BACKUP_DIR=/opt/enterprise-control-core/backups/postgres
ECC_BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_REAL_RECIPIENT
ECC_BACKUP_S3_URI=s3://REPLACE_WITH_BUCKET/ecc/postgres
ECC_BACKUP_RETENTION_DAYS=14
ECC_BACKUP_S3_SSE=AES256
