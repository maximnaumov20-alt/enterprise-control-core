[Unit]
Description=ECC expired authentication artifact cleanup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ecc-backup
Group=docker
WorkingDirectory=/opt/enterprise-control-core
ExecStart=/usr/bin/docker compose exec -T api python -m app.cleanup_expired_auth
Nice=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
