[Unit]
Description=ECC expired authentication artifact cleanup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=ecc-cleanup
Group=ecc-cleanup
WorkingDirectory=/opt/enterprise-control-core
ExecStart=/usr/bin/sudo -n /usr/bin/docker compose exec -T api python -m app.cleanup_expired_auth
Nice=10
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
