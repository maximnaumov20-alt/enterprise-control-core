# Copy this file to .env and replace every placeholder with a unique secret.
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
ECC_SECRET_KEY=REPLACE_WITH_DIFFERENT_RANDOM_HEX_SECRET

# Initial administrator account. Use a unique password with at least 12 characters.
ECC_ADMIN_EMAIL=admin@example.invalid
ECC_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
ECC_ADMIN_NAME=ECC Administrator
ECC_ORGANIZATION_NAME=Default Organization

ACCESS_TOKEN_MINUTES=20
CORS_ORIGINS=http://localhost:5173
