# Copy this file to .env and replace every placeholder with a unique secret.
# Generate secrets with: openssl rand -hex 32
POSTGRES_PASSWORD=
ECC_SECRET_KEY=

# Initial administrator account. Use a unique password with at least 12 characters.
ECC_ADMIN_EMAIL=
ECC_ADMIN_PASSWORD=
ECC_ADMIN_NAME=ECC Administrator
ECC_ORGANIZATION_NAME=Default Organization

ACCESS_TOKEN_MINUTES=20
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Exact browser origin(s), comma-separated. Use the HTTPS origin for a production domain.
CORS_ORIGINS=http://localhost:5173

# The frontend binds to loopback by default. Keep this for local access or a same-host TLS proxy.
ECC_FRONTEND_BIND_ADDRESS=127.0.0.1
ECC_FRONTEND_PORT=5173

# Optional comma-separated IPs/CIDRs of reverse proxies directly connecting to the frontend.
# Leave empty unless the proxy overwrites X-Forwarded-For and its source ranges are known.
ECC_TRUSTED_PROXY_CIDRS=
